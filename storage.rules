rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /reports/{userId}/{allPaths=**} {
      // Guest web reports — no login; path locked to web-guest.
      allow read: if request.auth != null || userId == "web-guest";
      allow write: if userId == "web-guest"
        && request.resource.size < 30 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
          || request.resource.contentType.matches('audio/.*')
        );
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 30 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
          || request.resource.contentType.matches('audio/.*')
        );
    }

    match /identity/{userId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Mangugnai TTS cache — officer owns path; any signed-in can read for replay.
    match /chat-tts/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    // Earth Engine DEM / hazard JSON cache (server ADC writes; officers may read).
    match /ee-cache/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
