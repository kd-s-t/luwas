rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && exists(userPath());
    }

    function userDoc() {
      return get(userPath()).data;
    }

    function isOfficer() {
      return userExists()
        && ("role" in userDoc())
        && userDoc().role == "officer";
    }

    function isCitizen() {
      return userExists()
        && ("role" in userDoc())
        && userDoc().role == "citizen";
    }

    function isDeveloper() {
      return userExists()
        && ("role" in userDoc())
        && userDoc().role == "developer";
    }

    // Legacy demos may omit accountStatus (or set null) — treat as active.
    // Never use == null / != null in rules; that throws "Null value error".
    function isActiveOfficer() {
      return isOfficer()
        && (
          !("accountStatus" in userDoc())
          || !(userDoc().accountStatus is string)
          || userDoc().accountStatus == "active"
        );
    }

    function isActiveDeveloper() {
      return isDeveloper()
        && (
          !("accountStatus" in userDoc())
          || !(userDoc().accountStatus is string)
          || userDoc().accountStatus == "active"
        );
    }

    /** Avoid null== comparisons when officerUid is missing on old roster rows. */
    function householdOwnedByCaller() {
      return ("officerUid" in resource.data)
        && resource.data.officerUid is string
        && resource.data.officerUid == request.auth.uid;
    }

    // Mangugnai command chat threads (+ meta doc) under the officer.
    match /users/{userId}/mangugnaiThreads/{threadId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || isOfficer()
        || isDeveloper()
      );
      // Keep create/update lean — nested hasOnly chains hit the 1000-expression cap.
      allow create: if signedIn()
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && (
          request.auth.uid == userId
          || isActiveOfficer()
          || isActiveDeveloper()
        );
      allow update: if signedIn()
        && request.resource.data.role == resource.data.role
        && (
          request.auth.uid == userId
          || isActiveOfficer()
          || isActiveDeveloper()
        );
      // Officers may delete orphan citizen profiles (email twins from seed drift).
      // Never delete your own doc or another officer via this path.
      allow delete: if isActiveOfficer()
        && request.auth.uid != userId
        && resource.data.role == "citizen";
    }

    // Onboarded barangay ops areas (hall pin, org, checklist).
    match /barangays/{barangayId} {
      allow read: if isOfficer() || isDeveloper();
      allow create, update: if (isOfficer() || isActiveDeveloper())
        && request.resource.data.barangay is string
        && request.resource.data.barangay.size() > 0
        && request.resource.data.lgu is string
        && request.resource.data.orgName is string
        && request.resource.data.center is map
        && request.resource.data.center.lat is number
        && request.resource.data.center.lng is number;
      allow delete: if isOfficer() || isActiveDeveloper();
    }

    match /households/{householdId} {
      // Signed-in users may read roster (citizen match on register + officer ops).
      allow read: if signedIn();
      allow create: if isActiveOfficer()
        && request.resource.data.officerUid == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() > 0
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.phone is string;
      allow update: if signedIn() && (
        (
          isActiveOfficer()
          && (
            householdOwnedByCaller()
            || (
              ("officerUid" in resource.data)
              && ("officerUid" in request.resource.data)
              && resource.data.officerUid is string
              && request.resource.data.officerUid is string
              && request.resource.data.officerUid == resource.data.officerUid
            )
          )
        )
        || (
          isCitizen()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "presence",
              "lastSeenLat",
              "lastSeenLng",
              "lastSeenArea",
              "lastSeenAt",
              "linkedCitizenUids",
              "updatedAt",
              "updatedAtServer"
            ])
          && (
            (
              ("email" in resource.data)
              && resource.data.email is string
              && ("email" in userDoc())
              && userDoc().email is string
              && resource.data.email == userDoc().email
            )
            || (
              ("linkedCitizenUids" in resource.data)
              && resource.data.linkedCitizenUids is list
              && request.auth.uid in resource.data.linkedCitizenUids
            )
          )
        )
        || (
          // Citizen self-link after register match (email may differ; uid must be added).
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["linkedCitizenUids", "updatedAt", "updatedAtServer"])
          && ("linkedCitizenUids" in request.resource.data)
          && request.resource.data.linkedCitizenUids is list
          && request.auth.uid in request.resource.data.linkedCitizenUids
        )
      );
      // Active officers may delete their roster rows; also allow cleanup of
      // legacy rows missing / non-string officerUid (null== used to throw).
      allow delete: if isActiveOfficer()
        && (
          householdOwnedByCaller()
          || !("officerUid" in resource.data)
          || !(resource.data.officerUid is string)
        );
    }

    // Barangay / LGU staff directory (captain, MDRRMO, tanods, …).
    match /barangayStaff/{staffId} {
      allow read: if isOfficer();
      allow create, update: if isOfficer()
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.title is string
        && request.resource.data.barangayId is string
        && request.resource.data.barangayId.size() > 0;
      allow delete: if isOfficer();
    }

    // External resource partners (NGO / DSWD / LGU) — directory only, no login.
    match /resourcePartners/{partnerId} {
      allow read: if isOfficer();
      allow create, update: if isOfficer()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.barangayId is string
        && request.resource.data.barangayId.size() > 0
        && request.resource.data.type is string
        && request.resource.data.contactName is string
        && request.resource.data.phone is string;
      allow delete: if isOfficer();
    }

    // Evacuation / shelter directory (location, capacity, on-site stock).
    // Public read so citizens can open shelters for their barangay.
    match /evacCenters/{centerId} {
      allow read: if true;
      allow create, update: if isOfficer()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.barangayId is string
        && request.resource.data.barangayId.size() > 0
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.maxCapacity is number
        && request.resource.data.maxCapacity >= 0;
      allow delete: if isOfficer();
    }

    // Barangay-owned disaster inventory (vehicles, generators, supplies).
    match /barangayInventory/{itemId} {
      allow read: if isOfficer();
      allow create, update: if isOfficer()
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.barangayId is string
        && request.resource.data.barangayId.size() > 0
        && request.resource.data.category is string
        && request.resource.data.unit is string
        && request.resource.data.available is number
        && request.resource.data.available >= 0;
      allow delete: if isOfficer();
    }

    // Shortage parent docs — id is the public code (e.g. RS-001).
    match /resources_shortages/{shortageId} {
      allow read: if isOfficer();
      allow create, update: if isOfficer()
        && request.resource.data.kind is string
        && request.resource.data.resourceLabel is string
        && request.resource.data.totalNeededL is number
        && request.resource.data.availableL is number
        && request.resource.data.shortageL is number;
      allow delete: if isOfficer();
    }

    // One suggestion doc per plan (id = RS-001); sitio requests nested in `requests`.
    match /resources_suggestions/{suggestionId} {
      allow read: if isOfficer();
      allow create, update: if isOfficer()
        && request.resource.data.shortageId is string
        && request.resource.data.shortageId.size() > 0
        && request.resource.data.kind is string
        && request.resource.data.requests is list;
      allow delete: if isOfficer();
    }

    match /reports/{reportId} {
      // Public feed can list reports; writers stay authenticated.
      allow read: if true;
      // Citizens and officers can both file field reports.
      allow create: if (
        (
          (isCitizen() || isOfficer())
          && request.resource.data.citizenUid == request.auth.uid
          && request.resource.data.status in ["draft", "queued"]
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.mediaUrl is string
          && request.resource.data.mediaUrl.size() > 0
        )
        || (
          // Curated map image-report seeds (rpt-*) — create-if-missing from the map.
          reportId.matches('rpt-.*')
          && request.resource.data.citizenUid == "demo-map-seed"
          && request.resource.data.status == "legit"
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.mediaUrl is string
          && request.resource.data.mediaUrl.size() > 0
        )
        || (
          // Guest reports: place id CEB-CON-NANG-YYMMDD-#### or legacy LUW-YYMMDD-####.
          (
            reportId.matches('LUW-[0-9]{6}-[0-9]{4}')
            || reportId.matches('[A-Z]{2,4}-[A-Z0-9]{2,8}-[A-Z0-9]{2,10}-[0-9]{6}-[0-9]{4}')
          )
          && request.resource.data.citizenUid in ["ios-guest", "web-guest"]
          && request.resource.data.source in ["ios", "web"]
          && request.resource.data.status in ["draft", "queued", "needs_review", "rejected"]
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.mediaUrl is string
          && request.resource.data.mediaUrl.size() > 0
          && request.resource.data.barangay is string
          && request.resource.data.lgu is string
        )
        || (
          // Place-prefixed demo seeds (legit) for Resources / map desk.
          reportId.matches('[A-Z]{2,4}-[A-Z0-9]{2,8}-[A-Z0-9]{2,10}-[0-9]{6}-[0-9]{4}')
          && request.resource.data.citizenUid == "demo-map-seed"
          && request.resource.data.status == "legit"
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.mediaUrl is string
          && request.resource.data.mediaUrl.size() > 0
        )
        || (
          // Demo “My reports” seeds for the signed-in user.
          reportId.matches('rpt-mine-.*')
          && (isCitizen() || isOfficer())
          && request.resource.data.citizenUid == request.auth.uid
          && request.resource.data.status in ["queued", "needs_review", "legit", "rejected"]
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.mediaUrl is string
          && request.resource.data.mediaUrl.size() > 0
        )
        || (
          // Evac center / desk supply requests (REQ-####).
          reportId.matches('REQ-[0-9]{4}')
          && isOfficer()
          && request.resource.data.citizenUid == request.auth.uid
          && request.resource.data.status in ["draft", "queued", "needs_review", "legit"]
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.mediaUrl is string
          && request.resource.data.mediaUrl.size() > 0
        )
      );
      // Allow re-sync of the same guest reference (idempotent write).
      allow update: if (
        (
          reportId.matches('LUW-[0-9]{6}-[0-9]{4}')
          || reportId.matches('[A-Z]{2,4}-[A-Z0-9]{2,8}-[A-Z0-9]{2,10}-[0-9]{6}-[0-9]{4}')
        )
        && resource.data.citizenUid in ["ios-guest", "web-guest"]
        && request.resource.data.citizenUid == resource.data.citizenUid
        && request.resource.data.source in ["ios", "web"]
        && request.resource.data.status in ["draft", "queued", "needs_review", "rejected"]
      );
      allow update: if (
        (
          signedIn() && (
            isOfficer()
            || (
              resource.data.citizenUid == request.auth.uid
              && request.resource.data.citizenUid == resource.data.citizenUid
            )
            || (
              // Comment/reaction counters only — any signed-in user
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(["commentCount", "reactionCounts", "updatedAt", "updatedAtServer"])
            )
          )
        )
        || (
          // Demo map seeds: attach nearby citizen name/purok after create
          reportId.matches('rpt-.*')
          && resource.data.citizenUid == "demo-map-seed"
          && request.resource.data.citizenUid == "demo-map-seed"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["citizenName", "citizenPurok", "updatedAt", "updatedAtServer"])
        )
      );
      allow delete: if isOfficer();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() < 2000
          && request.resource.data.displayName is string;
        allow update: if false;
        allow delete: if signedIn() && (
          resource.data.uid == request.auth.uid || isOfficer()
        );
      }

      match /reactions/{reactionUid} {
        allow read: if true;
        allow create, update: if signedIn()
          && request.auth.uid == reactionUid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type in ["like", "helpful", "concern"];
        allow delete: if signedIn() && request.auth.uid == reactionUid;
      }
    }

    // Website bug reports — guests + signed-in; developers triage;
    // ticket owners can track their own submissions.
    match /supportTickets/{ticketId} {
      allow read: if isDeveloper()
        || (signedIn() && resource.data.uid == request.auth.uid);
      // Anyone (guest or signed-in) may create; tickets go to developers.
      allow create: if (
          request.resource.data.kind == "bug"
          && request.resource.data.summary is string
          && request.resource.data.summary.size() > 0
          && request.resource.data.summary.size() <= 200
          && request.resource.data.details is string
          && request.resource.data.details.size() <= 4000
          && request.resource.data.status == "open"
          && request.resource.data.uid is string
          && request.resource.data.uid.size() > 0
          && request.resource.data.uid.size() <= 128
          && (
            request.resource.data.uid == "guest"
            || (signedIn() && request.resource.data.uid == request.auth.uid)
          )
          && (
            !("assignedToUid" in request.resource.data)
            || request.resource.data.assignedToUid == null
            || request.resource.data.assignedToUid == "ugnai-developers"
          )
        )
        // Demo seed rows (Developer → Support sample inbox).
        || (isActiveDeveloper()
          && ticketId.matches('sup-sample-[0-9]{3}')
          && request.resource.data.kind == "bug"
          && request.resource.data.summary is string
          && request.resource.data.summary.size() > 0
          && request.resource.data.summary.size() <= 200
          && request.resource.data.details is string
          && request.resource.data.details.size() <= 4000
          && request.resource.data.status in ["open", "in_progress", "resolved", "closed"]);
      // Developers triage tickets (status / assignee / resolution).
      allow update: if isActiveDeveloper()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.summary == resource.data.summary
        && request.resource.data.status in ["open", "in_progress", "resolved", "closed"]
        // assignedToName optional: missing / non-string (null) / string ≤120.
        && (!("assignedToName" in request.resource.data)
            || !(request.resource.data.assignedToName is string)
            || request.resource.data.assignedToName.size() <= 120);
      allow delete: if false;
    }
  }
}
