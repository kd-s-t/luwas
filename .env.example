# Local development — use Firebase emulators (see README)
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-dro.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-dro
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-dro.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo

# Optional — Gemini for AI Assist (falls back to local rules if unset)
# GEMINI_API_KEY=

# Production — set USE_EMULATORS=false and fill from Terraform outputs / Firebase console
# See docs/PRODUCTION.md
