# Local development — use Firebase emulators (see README)
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-dro.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-dro
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-dro.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo

# Optional — absolute public URL (email links, QR). Prod example:
# NEXT_PUBLIC_APP_URL=https://luwas-192332066427.asia-southeast1.run.app

# Optional — Gemini for chat assist + citizen report validation (falls back to local rules if unset)
# GEMINI_API_KEY=

# Optional — Google Weather / Elevation (Maps Platform). Cached ~30 min server-side.
# Falls back to free Open-Meteo if unset.
# GOOGLE_WEATHER_API_KEY=

# Optional — Resend email alerts (server-only). Demo/log mode if unset.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Luwas Alerts <onboarding@resend.dev>

# Optional — Semaphore SMS (server-only). Demo/log mode if unset.
# SEMAPHORE_API_KEY=
# SEMAPHORE_SENDER_NAME=LUWAS

# Optional — Twilio Voice calls (server-only). Demo/log mode if unset.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Production — NEXT_PUBLIC_USE_EMULATORS=false + real Firebase web config
# (Terraform output next_env_hint, or Firebase console → Project settings → Your apps)
# Server keys: set on Cloud Run / App Hosting secrets, never commit.
# See docs/PRODUCTION.md
