# Local development — use Firebase emulators (see README)
# Account email (keys tied to): you@example.com
# Console: https://console.firebase.google.com/
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-dro.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-dro
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-dro.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo

# Optional — absolute public URL (email links, QR). Prod example:
# NEXT_PUBLIC_APP_URL=https://luwasph.com

# Optional — Gemini for chat assist + citizen report validation (falls back to local rules if unset)
# Account email (keys tied to): you@example.com
# Console: https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Optional — Vertex AI AutoML image classification (predict on report photos).
# Account email (keys tied to): you@example.com
# Console: https://console.cloud.google.com/vertex-ai
# Create dataset → train → deploy endpoint in Vertex Console, then set:
# VERTEX_PROJECT_ID=your-gcp-project
# VERTEX_LOCATION=us-central1
# VERTEX_ENDPOINT_ID=1234567890
# Auth: GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json
#   or Application Default Credentials on Cloud Run / local `gcloud auth application-default login`
# Skips cleanly when unset (Gemini still validates).

# Optional — Google Weather / Elevation (Maps Platform). Cached ~30 min server-side.
# Account email (keys tied to): you@example.com
# Console: https://console.cloud.google.com/google/maps-apis
# Falls back to free Open-Meteo if unset.
# GOOGLE_WEATHER_API_KEY=

# Optional — Resend email alerts (server-only). Demo/log mode if unset.
# Account email (keys tied to): you@example.com
# Console: https://resend.com/api-keys
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="Luwas Alerts <alerts@luwasph.com>"
# Sandbox: fan out every alert email to these inboxes only (true|mode|1).
# RESEND_SANDBOX=mode
# RESEND_SANDBOX_TO=psabrenica@gmail.com
# RESEND_SANDBOX_TO=["psabrenica@gmail.com","inno.carljohndon@gmail.com"]

# Optional — ElevenLabs TTS for Mangluluwas replies (server-only).
# Falls back to browser speechSynthesis if unset.
# Console: https://elevenlabs.io/app/developers/api-keys
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional — Twilio Voice + SMS (server-only). Demo/log mode if unset.
# Account email (keys tied to): you@example.com
# Console: https://console.twilio.com/
# Voice works with From number. SMS needs toll-free Messaging registration.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Sandbox: fan out every Voice call AND SMS to these verified phones (true|mode|1).
# TWILIO_SANDBOX=mode
# TWILIO_SANDBOX_TO=09606057119,09171234567
# TWILIO_SANDBOX_TO=["09606057119","09171234567"]


# Production — NEXT_PUBLIC_USE_EMULATORS=false + real Firebase web config
# (Terraform output next_env_hint, or Firebase console → Project settings → Your apps)
# Server keys: set on Cloud Run / App Hosting secrets, never commit.
# See docs/PRODUCTION.md
