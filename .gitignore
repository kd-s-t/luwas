# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.gcloud-tmp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.tools/

# Firebase emulator / tools noise
firebase-debug.log
firestore-debug.log
ui-debug.log
.emulator-backup/

# Local report photo uploads (guest + signed-in uid folders)
/public/reports/guest/
/public/reports/*/
!/public/reports/flow-hazards/
!/public/reports/flow-hazards/**

# Cursor / local agent
.cursor/
.firebase/

# Earth Engine / local SA keys
.secrets/
/data/ee-runs/
